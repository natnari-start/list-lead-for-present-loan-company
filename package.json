{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:ci": "vite build --config vite.ci.config.ts",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs && node scripts/validate-appdeploy-tests.mjs && node scripts/validate-appdeploy-tests.mjs tests/production-smoke.json && node scripts/check-public-source.mjs",
    "verify:prelive": "npm run build:ci && npm test",
    "check:public-source": "node scripts/check-public-source.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
